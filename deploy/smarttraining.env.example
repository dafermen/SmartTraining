NODE_ENV=production
PORT=3000
FRONTEND_URL=https://smarttraining.innovalogic.tech
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
MAX_VIDEO_SIZE_MB=500
VIDEO_STORAGE_PATH=/var/lib/smarttraining/storage/videos
THUMBNAIL_STORAGE_PATH=/var/lib/smarttraining/storage/thumbnails
DATA_STORAGE_PATH=/var/lib/smarttraining/data
USER_DATABASE_PATH=/var/lib/smarttraining/data/users.sqlite
DOCUMENTATION_PATH=/var/www/smarttraining.innovalogic.tech/app/docs
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_COMPLETION_PERCENTAGE=80
PROGRESS_SAVE_INTERVAL_SECONDS=10
